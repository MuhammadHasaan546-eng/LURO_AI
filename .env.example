NODE_ENV="development"
APP_URL="http://localhost:3000"
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="luro-ai"
MONGODB_MAX_POOL_SIZE="10"
MONGODB_MIN_POOL_SIZE="0"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="10000"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_EMAIL_PASSWORD_ENABLED="true"
AUTH_NOTIFICATION_EMAILS_ENABLED="false"
EMAIL_APP_NAME="Luro AI"

# Optional Google OAuth pair
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Apple OAuth group
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Optional HTTPS email delivery webhook
EMAIL_FROM="noreply@example.com"
# Optional official social profiles included in authentication emails
SOCIAL_X_URL="https://x.com/your-handle"
SOCIAL_LINKEDIN_URL="https://www.linkedin.com/company/your-company"
SOCIAL_INSTAGRAM_URL="https://www.instagram.com/your-handle"

# Gmail SMTP: use a Google App Password in SMTP_PASS, never your normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-mailbox@example.com"
SMTP_PASS=""

EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# OpenAI or an OpenAI-compatible provider such as OpenRouter
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_IMAGE_MODEL="gpt-image-1"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Required together for generated image persistence
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required together for billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Monthly plan allowances
APP_FREE_MONTHLY_TOKENS="50000"
APP_FREE_MONTHLY_IMAGES="5"
APP_FREE_MONTHLY_PDF_PAGES="50"
APP_PRO_MONTHLY_TOKENS="1000000"
APP_PRO_MONTHLY_IMAGES="100"
APP_PRO_MONTHLY_PDF_PAGES="2000"
APP_MAX_PDF_BYTES="10000000"
