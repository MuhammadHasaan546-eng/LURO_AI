generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                     String             @id @default(cuid())
  email                  String             @unique
  firstName              String             @default("")
  lastName               String             @default("")
  emailVerifiedAt        DateTime?
  passwordHash           String?
  passwordChangedAt      DateTime?
  lastAuthenticatedAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  identities             ProviderIdentity[]
  sessions               Session[]
  tokens                 AuthToken[]
  auditEvents            AuditEvent[]
  pendingOAuthChallenges OAuthChallenge[]   @relation("OAuthChallengeUser")
}

model ProviderIdentity {
  id              String        @id @default(cuid())
  provider        OAuthProvider
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean       @default(false)
  displayName     String?
  userId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([provider, providerEmail])
}

model Session {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  csrfTokenHash   String
  userId          String
  expiresAt       DateTime
  idleExpiresAt   DateTime
  lastSeenAt      DateTime  @default(now())
  authenticatedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  userAgent       String?
  ipAddressHash   String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([idleExpiresAt])
}

model AuthToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model OAuthChallenge {
  id           String        @id @default(cuid())
  stateHash    String        @unique
  nonceHash    String
  codeVerifier String
  provider     OAuthProvider
  intent       String
  returnTo     String
  userId       String?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  user         User?         @relation("OAuthChallengeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model RateLimitBucket {
  id           String    @id
  count        Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([windowStart])
  @@index([blockedUntil])
}

model AuditEvent {
  id            String       @id @default(cuid())
  userId        String?
  event         String
  outcome       AuditOutcome
  ipAddressHash String?
  userAgent     String?
  metadata      String?
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}
